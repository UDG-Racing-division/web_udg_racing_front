
---
interface Props {
  title?: string;
  description?: string;
}

const { 
  title = 'UDG Racing Division',
  description = 'Equip de competició de la Universitat de Girona dedicat a la innovació en motorsport elèctric.'
} = Astro.props;
---

<!doctype html>
<html lang="ca">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
